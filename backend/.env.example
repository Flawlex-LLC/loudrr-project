# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Core
DEBUG=true
ITEMS_PER_PAGE=50
DATABASE_URL=postgresql+asyncpg://loudrr:loudrr@localhost:5432/loudrr

# Redis / task queue (Ch16)
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Legacy — Ch10 TweetScout is retired (score comes from loudrr-analytics)
TWEETSCOUT_API_KEY=

# Loudrr gateway (Ch13 reply verification via our own drop-in twitterapi.io-
# compatible service). This is the ONLY upstream — no fallback to
# api.twitterapi.io. Blank LOUDRR_GATEWAY_API disables verification (the
# benefit-of-the-doubt "skipped+passed" result fires for every claim).
LOUDRR_GATEWAY_API=
GATEWAY_BASE_URL=https://gateway.loudrr.com

# Loudrr analytics (Ch10 Loudrr Score — 0-6000, replaces TweetScout).
# Blank -> every score returns 0/Anon (graceful degrade).
LOUDRR_ANALYTICS_URL=
SCORE_SOURCE=loudrr

# X OAuth 2.0 (Ch11)
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=

# URLs / misc
SITE_URL=
LANDING_URL=
ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=

# Task queue (Ch16) — set true in prod with Redis + a running arq worker
USE_TASK_QUEUE=false

# Admin panel (Ch17) — /admin login; blank password disables admin login
SECRET_KEY=dev-insecure-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
