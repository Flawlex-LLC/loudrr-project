# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Core
DEBUG=true
ITEMS_PER_PAGE=50
DATABASE_URL=postgresql+asyncpg://loudrr:loudrr@localhost:5432/loudrr

# Redis / task queue (Ch16)
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Loudrr gateway (Ch13 reply verification via our own drop-in twitterapi.io-
# compatible service). This is the ONLY upstream — no fallback to
# api.twitterapi.io. Blank LOUDRR_GATEWAY_API disables verification (the
# benefit-of-the-doubt "skipped+passed" result fires for every claim).
LOUDRR_GATEWAY_API=
GATEWAY_BASE_URL=https://gateway.loudrr.com
# Sponsored accounts (admin > Sponsors): the WORKER turns new original posts of
# those X accounts into sponsored raid posts — gateway websocket push plus a
# search poll every SPONSOR_POLL_SECONDS (0 = push only). Needs LOUDRR_GATEWAY_API.
# Enable on the ONE prod worker only (each extra process polls and is billed again).
SPONSOR_STREAM_ENABLED=false
SPONSOR_POLL_SECONDS=20

# Score provider: "sorsa" (default — Sorsa's public profile pages) or
# "loudrr" (LEGACY analytics service, LOUDRR_ANALYTICS_URL below).
SCORE_PROVIDER=sorsa
# Proxy pool for Sorsa reads — Webshare host:port:user:pass entries separated
# by newlines/commas. Required in prod (the scraper refuses a bare IP). Locally
# SCRAPE_PROXY_FILE (default data/proxies/webshare.txt, gitignored) is used.
SCRAPE_PROXIES=

# LEGACY Loudrr analytics (SCORE_PROVIDER=loudrr only). Blank -> every score
# returns None (graceful degrade to default score).
LOUDRR_ANALYTICS_URL=

# X OAuth 2.0 (Ch11)
# Both callback URLs must be whitelisted in the X Developer Portal for the
# same app. CALLBACK_URL is the legacy post-approval verification flow;
# WAITLIST_CALLBACK_URL is the new step-1-of-signup flow. For local dev, both
# must be HTTPS tunnels (e.g. ngrok) — X rejects plain http:// redirect URIs.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=
X_OAUTH_WAITLIST_CALLBACK_URL=

# URLs / misc
SITE_URL=
LANDING_URL=
ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=

# Task queue (Ch16) — set true in prod with Redis + a running arq worker
USE_TASK_QUEUE=false

# Admin panel (Ch17) — /admin login; blank password disables admin login
SECRET_KEY=dev-insecure-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
