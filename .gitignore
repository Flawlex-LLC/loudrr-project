# =============================================================================
# loudrr-project monorepo .gitignore
# Per-service .gitignores still apply — this one covers cross-service noise.
# =============================================================================

# --- secrets ---
.env
.env.local
*.env.local
!.env.example
# infra API tokens (Hetzner/Contabo/Coolify/analytics key) — never commit
.env.infra

# --- scratch / review outputs (Claude sessions) ---
scratchpad-*.html

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
*.coverage
htmlcov/

# --- Node.js ---
node_modules/
.next/
.nuxt/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# --- databases + large data ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- editor / OS noise ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# --- logs + runtime output ---
*.log
logs/
mypy_output.txt
zap-scan-output.txt
*zap-scan-output.txt

# --- backups / analytics-service specifics ---
backup/
harvest/
data/
seed/loudrr_calibration.json.bak
