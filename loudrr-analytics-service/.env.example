# --- API keys ---
# Sorsa (the product we replicate) — used ONLY for ground-truth calibration.
# Public swagger needs no key; scoring endpoints do. Key was out of quota 2026-06-14.
SORSA_KEY=

# loudrr gateway (drop-in twitterapi.io) — PREFERRED data source for the crawl when set.
LOUDRR_GATEWAY_API=sk_live_xxx
# twitterapi.io — fallback data source. Header: X-API-Key.
TWITTERAPI_IO_KEY=

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loudrr_analytics
REDIS_URL=redis://localhost:6379/0

# --- Crawl knobs (drive cost; see docs/cost_model.md) ---
# Prefer bulk following-IDs ($0.0045/1k) if the endpoint exists; else profiles ($0.01/1k).
# Crawl uses the gateway BULK-IDs endpoint (/user/followings_ids): 5,000 IDs/page, no
# truncation, ~$0.0049/1k. IDs are all the edge graph needs. (profiles path kept as fallback)
CRAWL_IDS_PAGE_SIZE=5000          # 5,000 IDs/page (bulk-IDs tier)
CRAWL_PROFILE_PAGE_SIZE=200       # profiles fallback path only
CRAWL_MAX_FOLLOWING_PER_MEMBER=   # blank = UNCAPPED (every following; cheap at 5k/page)
CRAWL_CONCURRENCY=6              # parallel members; rate-capped below so this just keeps the pipe full
# Self-pace to the gateway's SUSTAINABLE throughput (~40k ids/min ≈ 120 calls/15min), not its
# burst ceiling — past sustainable it just sheds (502). Backoff on 502 stays in the client.
CRAWL_RATE_CALLS=120
CRAWL_RATE_WINDOW_S=900
CRAWL_MEMBER_MAX_RETRIES=10      # in-run retries before a member is deferred to the next pass
CRAWL_QPS=20                      # honor wallet QPS tier
CRAWL_DAILY_BUDGET_USD=50         # soft stop; crawler halts when exceeded
CRAWL_BUDGET_USD=500             # run_until_done per-pass budget

# --- Scoring knobs ---
PAGERANK_ALPHA=0.85               # damping
PAGERANK_MAX_ITER=100
SCORE_DISPLAY_SCALE=1000          # map normalized PR -> Sorsa-style thousands scale (calibrate later)

# --- Kaito mindshare scrape (docs/kaito_reverse_engineering.md) ---
# The /voices/* API is NOT Cloudflare-gated, so the default path is plain curl_cffi + rotating
# proxies (no browser). Datacenter (Webshare) proxies are fine here.
KAITO_API_BASE=https://hub.kaito.ai/api/v1
KAITO_PROXY_FILE=data/proxies/webshare.txt   # "host:port:user:pass" lines (gitignored). Blank = home IP.
# In prod the file isn't in the container (data/ gitignored) — paste the proxy lines here instead
# (newline/comma/semicolon separated). Only the Kaito SCRAPE needs proxies; the worker uses the gateway.
KAITO_PROXIES=
KAITO_CONCURRENCY=8
KAITO_IMPERSONATE=chrome124
KAITO_MAX_RETRIES=4

# --- Mindshare worker (RUN_MODE=mindshare; docs/deploy_mindshare.md) ---
MINDSHARE_VERTICALS=crypto        # crypto[,ai,trading]
MINDSHARE_TICK_SECONDS=3600       # hourly
MINDSHARE_MAX_PAGES=2             # tweets/account/tick
MINDSHARE_ROSTER_REFRESH_TICKS=24 # rebuild roster+weights every N ticks
CORS_ORIGINS=*                    # public read API; lock to the loudrr web origin in prod
# --- Camoufox fallback (only if the API host ever gets CF-gated) ---
KAITO_PROXY=                  # single browser proxy http://user:pass@host:port
KAITO_HEADLESS=false
KAITO_WINDOW_W=1200
KAITO_WINDOW_H=800

# --- Service ---
APP_ENV=dev
LOG_LEVEL=INFO
